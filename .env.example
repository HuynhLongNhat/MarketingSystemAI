
# ==========================================
# Application Environment
# ==========================================
# APP_ENV: development | staging | production
APP_ENV=development
NODE_ENV=development

# WEB_URL: origin frontend, nhiều giá trị cách nhau bằng dấu phẩy. Dùng cho CORS và Better Auth trustedOrigins.
WEB_URL=http://localhost:3000

# ==========================================
# Social Login (để trống nếu chưa dùng; ID và Secret phải đi cùng nhau)
# Redirect URI cần đăng ký ở nhà cung cấp:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/facebook
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ==========================================
# SMS OTP (đăng nhập bằng số điện thoại)
# SMS_PROVIDER: disabled | twilio. "disabled" = không gửi SMS thật.
# Twilio cần TWILIO_MESSAGING_SERVICE_SID hoặc TWILIO_FROM_NUMBER.
# ==========================================
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ==========================================
# NestJS API
# ==========================================
PORT=3002
WEB_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3002

# ==========================================
# Next.js Web
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3002

# ==========================================
# PostgreSQL
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/marketing_system_ai_local

# ==========================================
# Better Auth
# ==========================================
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# ==========================================
# Redis / BullMQ
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==========================================
# AI Credential Encryption
# ==========================================
# Server-side encryption key, 32 random bytes in base64.
# Do not commit the real value.
AI_CREDENTIAL_ENCRYPTION_KEY=fswKgtjofddvrR3VoqtyLfDJWsmcYsSDiFPUd1SBb5E=