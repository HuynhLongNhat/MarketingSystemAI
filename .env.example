
# ==========================================
# Application Environment
# ==========================================
APP_ENV=development
NODE_ENV=development

# ==========================================
# Application URLs
# ==========================================
WEB_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3002

# ==========================================
# Social Login
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Drive uses the same Google OAuth client above. Register this exact
# callback URL on that client; do not create a second client for token refresh.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3002/v1/knowledge-connections/google/callback

# Public configuration for the Google Picker browser SDK. The Drive app ID is
# derived server-side from GOOGLE_CLIENT_ID so it cannot drift to another
# Cloud project.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ==========================================
# SMS OTP
# ==========================================
# disabled | twilio
SMS_PROVIDER=disabled

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ==========================================
# NestJS API
# ==========================================
PORT=3002

# ==========================================
# Next.js Web
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3002

# ==========================================
# PostgreSQL
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/marketing_system_ai_local

# ==========================================
# Better Auth
# ==========================================
# Generate a unique secret for each environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# ==========================================
# Redis / BullMQ
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379p

# ==========================================
# AI Credential Encryption
# ==========================================
# Generate 32 cryptographically random bytes and encode as Base64.
# Never use this example value in development, staging or production.
# Never commit the real value.
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-your-own-32-byte-base64-key
