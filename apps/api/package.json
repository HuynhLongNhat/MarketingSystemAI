{
  "name": "@workspace/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "test:queue": "node dist/jobs/test-enqueue.js",
    "research:tavily": "pnpm run build && node dist/search-providers/tavily-search.harness.js",
    "test:security": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/security/security.spec.js",
    "test:security:http": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/security/security-http.spec.js",
    "test:auth": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/auth/phone-number.spec.js dist-security-test/auth/otp-rate-limiter.spec.js dist-security-test/common/sms/sms-provider.spec.js",
    "test:chat": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/conversations/knowledge-ranking.spec.js dist-security-test/conversations/reply-guard.spec.js dist-security-test/conversations/playground-policy.spec.js dist-security-test/conversations/public-widget-ai.rag.spec.js dist-security-test/conversations/rag-trace.spec.js",
    "test:tasks:integration": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/tasks/tasks.integration.spec.js",
    "test:research-schema:integration": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/tasks/research-schema.integration.spec.js"
    ,"test:search-providers": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/search-providers/search-provider-connection-test.service.spec.js dist-security-test/search-providers/search-provider-test-rate-limiter.service.spec.js"
    ,"test:search-providers:integration": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/search-providers/search-providers.integration.spec.js"
    ,"test:search-providers:http": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/security/search-providers-http.spec.js"
    ,"test:agent-capabilities": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/agents/agent-capabilities.spec.js"
    ,"test:widget-auth:integration": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/conversations/public-widget-auth.integration.spec.js"
    ,"test:widget-http:integration": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/conversations/public-widget-http.integration.spec.js"
    ,"test:search-adapter": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/search-providers/tavily-search.adapter.spec.js"
    ,"test:widget-security": "tsc -p tsconfig.security-test.json && node --import ./dist-security-test/test-env.js --test dist-security-test/conversations/public-widget-origin.guard.spec.js dist-security-test/conversations/public-widget-rate-limit.guard.spec.js"
    ,"test": "pnpm run test:auth && pnpm run test:security && pnpm run test:chat && pnpm run test:tasks:integration && pnpm run test:research-schema:integration && pnpm run test:search-providers && pnpm run test:search-providers:integration && pnpm run test:search-providers:http && pnpm run test:agent-capabilities && pnpm run test:widget-security && pnpm run test:widget-auth:integration"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@workspace/db": "workspace:*",
    "better-auth": "^1.7.13",
    "bullmq": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@workspace/eslint-config": "workspace:^",
    "eslint": "^9",
    "typescript": "^5.7.3"
  }
}
