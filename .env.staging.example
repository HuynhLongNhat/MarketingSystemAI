# Backend/Worker only: copy to the Oracle VM as .env.staging (never commit it).
APP_ENV=staging
NODE_ENV=production
PORT=3002
DATABASE_URL=postgresql://staging_user:replace@neon-host/staging_db?sslmode=require
REDIS_HOST=redis
REDIS_PORT=6379
WEB_URL=https://staging.example.com
BETTER_AUTH_URL=https://api-staging.example.com/v1
BETTER_AUTH_SECRET=replace_with_a_32_plus_character_staging_secret
AI_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_base64_32_byte_staging_key
INTEGRATION_TOKEN_ENCRYPTION_KEY=replace_with_a_base64_32_byte_staging_key
GOOGLE_CLIENT_ID=replace_if_google_login_or_drive_is_enabled
GOOGLE_CLIENT_SECRET=replace_if_google_login_or_drive_is_enabled
GOOGLE_DRIVE_REDIRECT_URI=https://api-staging.example.com/v1/knowledge-connections/google/callback
# Optional integrations: configure only when the related feature is enabled.
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
# INVITATION_FROM_EMAIL=
